---
import { projectHref, type Project } from '../lib/projects';
import { Image, getImage } from 'astro:assets';
import workshop from '../assets/atelier/winter-workshop.png';
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const heroPreview = await getImage({ src: workshop, width: 48, format: 'webp', quality: 28 });
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-scene" aria-hidden="true" style={`--art-preview: url("${heroPreview.src}")`}><Image src={workshop} alt="" class="atelier-image" data-progressive widths={[640, 1024, 1672]} sizes="100vw" format="webp" quality={78} loading="eager" fetchpriority="high" /><div class="hero-veil"></div></div>
  <div class="hero-grid wrap">
    <div class="hero-copy">
      <p class="hero-brow"><span class="status-dot" aria-hidden="true"></span> GAMEPLAY ENGINEER & WORLD BUILDER</p>
      <p class="hero-kicker">游戏开发 · 系统设计</p>
      <h1 id="hero-title"><span>让规则</span><span>凝成<em>世界。</em></span></h1>
      <p class="hero-translation">From systems to playable worlds.</p>
      <p class="hero-description">专注 Unreal Engine 客户端开发。<br />聚焦 C++、Gameplay 系统设计与模块化架构。</p>
      <div class="hero-actions"><a class="main-link" href="#screenings">进入作品展厅 <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
    <nav class="hero-projects wrap" aria-label="代表作品快捷入口">
      <div class="hero-projects-head"><span>代表作品</span></div>
      {projects.map((project, index) => <a class="hero-project" href={projectHref(project)} aria-label={`进入 ${project.data.title} 案例`}>
        <span class="hero-project-number">{String(index + 1).padStart(2, '0')}</span>
        <div><span class="hero-project-genre">{project.data.genre}</span><strong>{project.data.title}</strong><p>{project.data.cardCaption}</p></div>
        <span class="hero-project-arrow" aria-hidden="true">↗</span>
      </a>)}
    </nav>
</section>
