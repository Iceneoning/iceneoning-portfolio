---
import ArchiveIndex from './ArchiveIndex.astro';
import type { ProjectCategory } from '../config/project-sections';

interface Props { counts: Record<ProjectCategory, number>; blogHref: string; }
const { counts, blogHref } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid wrap">
    <div class="hero-copy">
      <p class="hero-kicker">冰霓 · 创作档案</p>
      <h1 id="hero-title"><span>让创作</span><span>留下<em>轨迹。</em></span></h1>
      <p class="hero-translation">From code to worlds, and everything in between.</p>
      <p class="hero-description">游戏系统、角色渲染、前端交互与后端工程。<br />记录一直以来的项目、实践与持续探索。</p>
      <div class="hero-actions">
        <a class="main-link" href="#games">进入游戏放映厅 <span aria-hidden="true">↓</span></a>
        <a class="hero-blog-link" href={blogHref}>阅读博客 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <ArchiveIndex counts={counts} />
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(ellipse at 74% 45%, #dbe6f3, transparent 64%),
      linear-gradient(115deg, #f8f7f3 14%, #f0f3f7 100%);
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, .94fr) minmax(0, 1.12fr);
    align-items: center;
    gap: clamp(28px, 5vw, 84px);
    padding-block: clamp(56px, 6vw, 86px);
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 22px;
    color: var(--ink-2);
    font-size: 13px;
    letter-spacing: .12em;
  }

  .hero-kicker::before { content: ""; width: 19px; height: 1px; background: #7b93b3; }
  h1 { margin: 0; font: 400 clamp(46px, 5.5vw, 88px)/1.12 var(--serif); letter-spacing: -.055em; }
  h1 > span { display: block; }
  h1 em { color: var(--ice); font-style: normal; }
  .hero-translation { margin: 20px 0 0; color: #516a8b; font: italic 17px/1.6 var(--serif); }
  .hero-description { margin: 23px 0 0; color: var(--ink-2); font-size: 14px; line-height: 1.95; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 20px; margin-top: 27px; }
  .hero-blog-link { display: inline-flex; align-items: center; min-height: 44px; gap: 8px; font-size: 13px; font-weight: 600; color: var(--ice); }
  .hero-blog-link:hover { text-decoration: underline; text-underline-offset: 5px; }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 26px; padding-block: 34px; }
    h1 { font-size: clamp(44px, 11vw, 70px); }
    .hero-kicker { font-size: 12px; margin-bottom: 15px; }
    .hero-translation { font-size: 14px; margin-top: 12px; }
    .hero-description { font-size: 13px; margin-top: 15px; }
    .hero-actions { margin-top: 17px; }
  }
</style>
