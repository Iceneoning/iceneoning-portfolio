---
import { Image } from 'astro:assets';
import { animeArt } from '../lib/anime-art';

interface Props { total: number; sectionCount: number; blogHref: string; }
const { total, sectionCount, blogHref } = Astro.props;
const roles = ['游戏系统', '角色渲染', '前端交互', '后端工程', '奇妙的小实验'];
---
<section class="ahero" aria-labelledby="hero-title">
  <div class="ahero-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="ahero-grid wrap">
    <div class="ahero-copy">
      <p class="hero-kicker" data-reveal><span class="kana-chip">ようこそ</span>冰霓 · 创作档案</p>
      <h1 id="hero-title" data-reveal><span>让创作</span><span>留下<em>轨迹。</em></span></h1>
      <p class="ahero-role" data-reveal aria-label={`我在做：${roles.join('、')}`}>
        <span aria-hidden="true">我在做 <b data-typer data-words={JSON.stringify(roles)}>{roles[0]}</b><i class="ahero-caret"></i></span>
      </p>
      <p class="hero-description" data-reveal>游戏系统、角色渲染、前端交互与后端工程。<br />记录一直以来的项目、实践与持续探索。</p>
      <div class="hero-actions" data-reveal>
        <a class="main-link main-link--glow" href="#games">进入游戏放映厅 <span aria-hidden="true">↓</span></a>
        <a class="hero-blog-link" href={blogHref}>阅读博客 <span aria-hidden="true">↗</span></a>
      </div>
      <dl class="ahero-stats" data-reveal>
        <div><dt>收录作品</dt><dd>{String(total).padStart(2, '0')}</dd></div>
        <div><dt>作品分区</dt><dd>{String(sectionCount).padStart(2, '0')}</dd></div>
        <div><dt>持续更新</dt><dd>∞</dd></div>
      </dl>
    </div>

    <div class="ahero-art" data-tilt data-tilt-max="7" data-hero-art>
      <div class="ahero-ring" aria-hidden="true"></div>
      <div class="ahero-frame">
        <Image src={animeArt.hero} alt="原创看板娘冰霓：银白长发、戴雪花发夹的少女，身后是极光与漂浮的全息界面" widths={[420, 640, 900]} sizes="(max-width: 820px) 86vw, 40vw" format="webp" quality={80} loading="eager" fetchpriority="high" class="ahero-image" />
        <span class="ahero-shine" aria-hidden="true"></span>
        <span class="ahero-credit">AI 绘制 · 原创看板娘「冰霓」</span>
      </div>
      <span class="ahero-badge ahero-badge--1" data-depth="26" aria-hidden="true">✦ Game Dev</span>
      <span class="ahero-badge ahero-badge--2" data-depth="40" aria-hidden="true">Shader ✧</span>
      <span class="ahero-badge ahero-badge--3" data-depth="18" aria-hidden="true">❄ Web &amp; Server</span>
      <button class="ahero-bubble" type="button" data-hero-bubble data-depth="34">
        <span data-hero-line aria-live="polite">欢迎来到我的创作档案！<br />戳戳我，或者往下看看作品吧～</span>
      </button>
    </div>
  </div>
  <a class="ahero-scroll" href="#sections" aria-label="向下浏览作品分区"><span aria-hidden="true"></span></a>
</section>

<style>
  .ahero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(50% 60% at 80% 38%, #e2e4ff 0%, transparent 70%),
      radial-gradient(38% 45% at 98% 96%, #ffe0ee 0%, transparent 70%),
      radial-gradient(40% 50% at 0% 0%, #dff1ff 0%, transparent 70%),
      linear-gradient(180deg, #f9fbff, #f3f5fd);
    border-bottom: 1px solid var(--line);
  }

  .ahero-aurora { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ahero-aurora i {
    position: absolute;
    width: 46vw;
    height: 46vw;
    border-radius: 50%;
    filter: blur(70px);
    opacity: .5;
    animation: aurora-drift 18s ease-in-out infinite alternate;
  }
  .ahero-aurora i:nth-child(1) { top: -18vw; left: -8vw; background: #bfe0ff; }
  .ahero-aurora i:nth-child(2) { top: 6vw; right: -14vw; background: #d6ccff; animation-delay: -6s; }
  .ahero-aurora i:nth-child(3) { bottom: -26vw; left: 30vw; background: #ffd3e6; animation-delay: -12s; }
  @keyframes aurora-drift { to { transform: translate3d(4vw, 3vw, 0) scale(1.12); } }

  .ahero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .92fr);
    align-items: center;
    gap: clamp(28px, 5vw, 80px);
    padding-block: clamp(48px, 6vw, 84px) clamp(64px, 7vw, 96px);
  }

  .hero-kicker { display: flex; align-items: center; gap: 12px; margin: 0 0 22px; color: var(--ink-2); font-size: 13px; letter-spacing: .12em; }
  h1 { margin: 0; font: 400 clamp(48px, 5.8vw, 92px)/1.1 var(--serif); letter-spacing: -.055em; }
  h1 > span { display: block; }
  h1 em {
    font-style: normal;
    background: var(--aurora-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ahero-role { margin: 22px 0 0; font-size: clamp(16px, 1.5vw, 20px); color: var(--ink-2); min-height: 1.7em; }
  .ahero-role b { color: var(--ice); font-weight: 600; }
  .ahero-caret { display: inline-block; width: 2px; height: 1.05em; margin-left: 3px; vertical-align: -.15em; background: var(--sakura); animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }

  .hero-description { margin: 18px 0 0; color: var(--ink-2); font-size: 14px; line-height: 1.95; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 20px; margin-top: 28px; }
  .hero-blog-link { display: inline-flex; align-items: center; min-height: 44px; gap: 8px; font-size: 13px; font-weight: 600; color: var(--ice); }
  .hero-blog-link:hover { text-decoration: underline; text-underline-offset: 5px; }

  .ahero-stats { display: flex; gap: clamp(18px, 3vw, 40px); margin: 38px 0 0; }
  .ahero-stats div { position: relative; padding-left: 14px; }
  .ahero-stats div::before { content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 3px; border-radius: 3px; background: var(--aurora); }
  .ahero-stats dt { font-size: 11px; letter-spacing: .1em; color: #6a7c96; }
  .ahero-stats dd { margin: 4px 0 0; font: italic 600 30px/1 var(--serif); color: var(--ink); font-variant-numeric: tabular-nums; }

  /* Artwork card with pointer parallax (driven by --rx/--ry/--mx/--my from anime-fx). */
  .ahero-art {
    --rx: 0deg; --ry: 0deg; --mx: 0; --my: 0;
    position: relative;
    justify-self: center;
    width: min(100%, 470px);
    transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform .4s var(--ease);
  }
  .ahero-ring {
    position: absolute;
    inset: -7% -9%;
    border-radius: 50%;
    border: 1.5px dashed #9fb6ff88;
    animation: ring-spin 40s linear infinite;
    pointer-events: none;
  }
  .ahero-ring::after { content: "❄"; position: absolute; top: 8%; right: 14%; color: #8eaaf5; font-size: 18px; }
  @keyframes ring-spin { to { transform: rotate(360deg); } }

  .ahero-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 30px;
    border: 3px solid #fff;
    background: linear-gradient(160deg, #dfe8ff, #f3dcff);
    box-shadow: 0 30px 60px -28px #3b4f9a88, 0 0 0 1px #c9d4f5, 0 0 60px -10px #b9a8ff66;
  }
  .ahero-image { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.04) translate3d(calc(var(--mx) * -8px), calc(var(--my) * -8px), 0); transition: transform .4s var(--ease); }
  .ahero-shine {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at calc(50% + var(--mx) * 40%) calc(30% + var(--my) * 40%), #ffffff55, transparent 45%);
    mix-blend-mode: soft-light;
  }
  .ahero-credit { position: absolute; left: 12px; bottom: 12px; padding: 5px 10px; border-radius: 999px; background: #0f1d3a8c; color: #eef3ff; font-size: 10px; letter-spacing: .04em; backdrop-filter: blur(6px); }

  .ahero-badge, .ahero-bubble {
    position: absolute;
    transform: translate3d(calc(var(--mx) * var(--d, 20) * 1px), calc(var(--my) * var(--d, 20) * 1px), 40px);
    transition: transform .4s var(--ease);
  }
  .ahero-badge {
    padding: 8px 14px;
    border: 1px solid #ffffffcc;
    border-radius: 999px;
    background: #ffffffb8;
    color: var(--ink);
    font: 600 12px/1 var(--sans);
    letter-spacing: .03em;
    box-shadow: 0 10px 24px -14px #2c3f7a77;
    backdrop-filter: blur(10px);
    white-space: nowrap;
    animation: badge-float 5s ease-in-out infinite;
  }
  .ahero-badge--1 { --d: 26; top: 12%; left: -12%; color: #3d63b8; }
  .ahero-badge--2 { --d: 40; top: 44%; right: -13%; color: #8a5ad6; animation-delay: -1.6s; }
  .ahero-badge--3 { --d: 18; bottom: 9%; left: -8%; color: #c2508a; animation-delay: -3.1s; }
  @keyframes badge-float { 50% { translate: 0 -8px; } }

  .ahero-bubble {
    --d: 34;
    top: -5%;
    right: -6%;
    max-width: 230px;
    padding: 12px 15px;
    border: 2px solid #c8d4ff;
    border-radius: 18px 18px 4px 18px;
    background: #fff;
    color: var(--ink);
    font: 500 12.5px/1.65 var(--sans);
    text-align: left;
    cursor: pointer;
    box-shadow: 0 14px 30px -18px #2c3f7a88;
  }
  .ahero-bubble::after { content: ""; position: absolute; right: 26px; bottom: -9px; width: 14px; height: 14px; background: #fff; border-right: 2px solid #c8d4ff; border-bottom: 2px solid #c8d4ff; transform: rotate(45deg); }
  .ahero-bubble:hover { border-color: var(--sakura); }
  .ahero-bubble.is-pop { animation: bubble-pop .45s var(--ease); }
  @keyframes bubble-pop { 0% { scale: .9; } 60% { scale: 1.05; } 100% { scale: 1; } }

  .ahero-scroll { position: absolute; left: 50%; bottom: 18px; translate: -50% 0; display: grid; place-items: center; width: 44px; height: 44px; }
  .ahero-scroll span { width: 22px; height: 34px; border: 2px solid #8ea4c8; border-radius: 12px; position: relative; }
  .ahero-scroll span::after { content: ""; position: absolute; left: 50%; top: 6px; width: 4px; height: 7px; margin-left: -2px; border-radius: 2px; background: var(--sakura); animation: scroll-dot 1.6s ease-in-out infinite; }
  @keyframes scroll-dot { 70%, 100% { transform: translateY(12px); opacity: 0; } }

  @media (max-width: 1100px) {
    .ahero-badge--1 { left: -4%; }
    .ahero-badge--2 { right: -4%; }
    .ahero-bubble { right: -2%; }
  }
  @media (max-width: 820px) {
    .ahero-grid { grid-template-columns: minmax(0, 1fr); gap: 46px; padding-block: 36px 78px; }
    h1 { font-size: clamp(44px, 12vw, 70px); }
    .ahero-art { width: min(86%, 400px); }
    .ahero-badge { font-size: 11px; padding: 7px 11px; }
    .ahero-badge--1 { left: -8%; }
    .ahero-badge--2 { right: -10%; }
    .ahero-bubble { top: -8%; right: -8%; max-width: 190px; font-size: 11.5px; }
    .ahero-stats { margin-top: 28px; }
    .ahero-stats dd { font-size: 25px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ahero-art, .ahero-image, .ahero-badge, .ahero-bubble { transform: none !important; }
  }
</style>
