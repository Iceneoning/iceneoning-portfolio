---
import { Image, getImage } from 'astro:assets';
import settlement from '../assets/atelier/winter-settlement.webp';
import archive from '../assets/atelier/winter-archive.webp';
interface Props { warm?: boolean; wide?: boolean; }
const { warm = false, wide = false } = Astro.props;
const artwork = warm ? archive : settlement;
const artPreview = await getImage({ src: artwork, width: 48, format: 'webp', quality: 28 });
---
<span class="artwork-frame" style={`--art-preview: url("${artPreview.src}")`}>
  <Image
    src={artwork}
    alt="" aria-hidden="true" class="portfolio-artwork" data-progressive
    width={1200} widths={[480, 800, 1200]}
    sizes={wide
      ? '(max-width: 820px) calc(100vw - 40px), min(90vw, 1260px)'
      : '(max-width: 700px) max(400px, calc(79vw - 25px)), (max-width: 1024px) clamp(570px, 71vw, 700px), clamp(686px, 53vw, 820px)'}
    format="webp" quality={76} decoding="async" loading={wide ? 'eager' : 'lazy'} fetchpriority={wide ? 'high' : 'low'}
  />
</span>
