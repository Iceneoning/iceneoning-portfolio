---
import { getImage } from 'astro:assets';
import { animeArt } from '../lib/anime-art';

interface Props { home?: boolean; }
const { home = false } = Astro.props;
const chibi = await getImage({ src: animeArt.chibi, width: 280, format: 'webp', quality: 82 });
---
<div class="snow-layer" aria-hidden="true" data-snow></div>
<aside class="mascot" aria-label="看板娘冰霓" data-mascot data-mascot-page={home ? 'home' : 'case'}>
  <p class="mascot-bubble" data-mascot-bubble role="status" aria-live="polite" hidden></p>
  <div class="mascot-tools">
    <button type="button" class="mascot-tool" data-fx-snow aria-pressed="true" title="下雪开关"><span aria-hidden="true">❄</span><span class="sr-only">切换飘雪</span></button>
    <button type="button" class="mascot-tool" data-fx-top title="回到顶部"><span aria-hidden="true">↑</span><span class="sr-only">回到顶部</span></button>
    <button type="button" class="mascot-tool" data-mascot-hide title="收起看板娘"><span aria-hidden="true">×</span><span class="sr-only">收起看板娘</span></button>
  </div>
  <button type="button" class="mascot-body" data-mascot-poke aria-label="和冰霓说说话">
    <img src={chibi.src} width="140" height="140" alt="" decoding="async" loading="lazy" />
  </button>
</aside>
<button type="button" class="mascot-summon" data-mascot-show hidden><span aria-hidden="true">❄</span> 召唤冰霓</button>

<script>
  import { initAnimeFx } from '../scripts/anime-fx';
  initAnimeFx();
</script>
