---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimeHero from '../components/AnimeHero.astro';
import SectionCards from '../components/SectionCards.astro';
import SectionShortcuts from '../components/SectionShortcuts.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { getPublishedProjects, type Project } from '../lib/projects';
import { projectSections, type ProjectCategory } from '../config/project-sections';
import { animeArt } from '../lib/anime-art';

const projects = await getPublishedProjects();
const blog = {
  href: 'https://iceneoning-blog.pages.dev/',
  title: '冰霓的博客',
  description: '记录游戏开发实践、技术实验与个人创作。',
};
const sections = Object.fromEntries(
  projectSections.map(({ id }) => [id, projects.filter((project) => project.data.category === id)]),
) as Record<ProjectCategory, Project[]>;
const counts = Object.fromEntries(
  projectSections.map(({ id }) => [id, sections[id].length + (id === 'frontend' ? 1 : 0)]),
) as Record<ProjectCategory, number>;
// Skill tags come straight from project frontmatter (engine + stack), without version numbers.
const skills = [...new Set(projects.flatMap(({ data }) => [
  ...(data.engine ? data.engine.split('/') : []),
  ...data.stack,
]).map((skill) => skill.replace(/\s+\d+(\.\d+)*\s*$/, '').trim()).filter(Boolean))];
---
<BaseLayout title="ICE：CREATIVE ARCHIVE" description="冰霓的个人作品集，收录游戏开发、图形学与渲染、前端开发和后端工程实践。" home>
  <main id="main" tabindex="-1">
    <SectionShortcuts />
    <AnimeHero total={projects.length} sectionCount={projectSections.length} blogHref={blog.href} />
    <SectionCards counts={counts} />
    <ProjectShowcase projects={sections.games} />
    {projectSections.slice(1).map((section) => (
      <ProjectSection
        section={section}
        projects={sections[section.id]}
        externalLink={section.id === 'frontend' ? blog : undefined}
      />
    ))}
    <section class="about about-anime wrap" id="about" aria-label="关于这个作品集">
      <figure class="about-art" data-tilt data-tilt-max="4" data-reveal>
        <div class="about-art-frame">
          <Image src={animeArt.about} alt="冰霓在雪夜的书桌前写代码，两块屏幕分别显示游戏引擎视口和代码" widths={[560, 900, 1300]} sizes="(max-width: 820px) calc(100vw - 40px), 52vw" format="webp" quality={78} loading="lazy" />
        </div>
        <figcaption>AI 绘制 · 原创看板娘「冰霓」的深夜工作台</figcaption>
      </figure>
      <div data-reveal>
        <p class="kana-label"><span>じこしょうかい</span> · ABOUT / CREATIVE ARCHIVE</p>
        <h2>从代码到世界，<br /><em>记录每一次创造。</em></h2>
        <p class="about-text">这里收录我的游戏开发、图形学与渲染、前端和后端工程实践。项目案例记录我参与的工作、关键实现和可查看的成果。</p>
        <ul class="skill-cloud" aria-label="作品中用到的技术">
          {skills.map((skill) => <li>{skill}</li>)}
        </ul>
        <a class="about-demo-link" href="https://pan.quark.cn/s/a831fd3701c4" target="_blank" rel="noopener noreferrer" aria-label="前往夸克网盘下载游戏 Demo（在新标签页打开）" data-mascot-say="游戏 Demo 放在夸克网盘里，下载下来亲手玩玩看吧！">
          <span>
            <strong class="about-demo-label">前往下载游戏 Demo</strong>
            <span class="about-demo-source">夸克网盘 · 外部链接</span>
          </span>
          <span class="about-demo-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
